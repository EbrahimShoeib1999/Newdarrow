rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Platform Administrator: comprehensive cross-tenant authority across the entire platform.
    // Privileges are derived strictly from trusted Firebase Auth custom claims, NEVER from Firestore profile fallbacks.
    function isPlatformAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'platform_admin';
    }

    function belongsToCompany(companyId) {
      // `.get()` guard: a users doc missing `companyId` (partial profile)
      // must evaluate to false, not ERROR out every dependent rule and turn
      // a clean denial into an "evaluation error" permission-denied.
      return signedIn() && (
        isPlatformAdmin()
        || (
          hasUserDoc()
          && userDoc().get('companyId', '') == companyId
          && userDoc().get('onboardingStatus', 'active') != 'pending'
        )
      );
    }

    function isCompanyAdmin(companyId) {
      return isPlatformAdmin()
        || (belongsToCompany(companyId) && userDoc().get('role', '') in ['super_admin', 'admin']);
    }

    function isGlobalHrManager(companyId) {
      return belongsToCompany(companyId)
        && userDoc().get('role', '') == 'global_hr_manager';
    }

    // Platform super admin, independent of any single tenant. Used only by the
    // account-reconciliation list gate below, which is pinned to unassigned
    // (empty-companyId) profiles so it exposes no tenant's roster.
    function isSuperAdmin() {
      return signedIn() && (
        isPlatformAdmin()
        || (hasUserDoc() && userDoc().get('role', '') == 'super_admin')
      );
    }

    // Effective People sub-role; empty string means "fall back to the global role".
    // Guarded with `is map` because a null/absent field would make .get() error out,
    // which rules treat as a denial.
    function peopleSubRole() {
      return userDoc().get('portalSubRoles', {}) is map
        ? userDoc().get('portalSubRoles', {}).get('people', '')
        : '';
    }

    function customPermissions() {
      return userDoc().get('customPermissions', []) is list
        ? userDoc().get('customPermissions', [])
        : (userDoc().get('permissions', []) is list ? userDoc().get('permissions', []) : []);
    }

    // Effective Billing sub-role; empty string means "fall back to the global role".
    function billingSubRole() {
      return userDoc().get('portalSubRoles', {}) is map
        ? userDoc().get('portalSubRoles', {}).get('billing', '')
        : '';
    }

    // The tenant's primary business activity is the authoritative source that
    // activity-aware routing resolves from — so a write may only persist a
    // known stable id (never a display name or arbitrary string).
    function validPrimaryActivity(data) {
      return !('primaryActivity' in data)
        || data.primaryActivity == null
        || data.primaryActivity in [
          'PROJECTS',
          'REAL_ESTATE_MANAGEMENT',
          'REAL_ESTATE_BROKERAGE',
          'FACILITIES_MANAGEMENT',
          'REAL_ESTATE_DEVELOPMENT',
          'MARKETING_AGENCY',
          'MEDICAL_CLINIC',
          'SCHOOL_MANAGEMENT'
        ];
    }

    function primaryActivityUnchanged() {
      return resource.data.get('primaryActivity', '')
        == request.resource.data.get('primaryActivity', '');
    }

    // ---- Phase 2: activity-aware domain data boundary (release-critical) ----
    //
    // Each Phase-2 domain module stores records in subcollections whose names
    // begin with a reserved per-activity prefix. Deriving the owning activity
    // from the collection NAME (not from a document field) is what makes this
    // boundary authoritative: a client-supplied `activity`/`primaryActivity`
    // field on the record itself can never be used to grant access, and any
    // new domain collection is protected fail-closed the moment it is written
    // — no rule edit required. Kept in sync with
    // src/features/activities/types/activity-domain.ts.
    //
    // PROJECTS is intentionally absent: it already persists in bare shared
    // collections (projects/tasks/sprints/…), so leaving it un-prefixed keeps
    // every existing tenant working with zero regression.
    // NOTE: Firestore rules have no String.startsWith(); prefix detection uses
    // the supported matches() (regex is matched against the whole string).
    function domainOwnerActivity(collection) {
      return collection.matches('^rem_.*') ? 'REAL_ESTATE_MANAGEMENT'
        : collection.matches('^reb_.*') ? 'REAL_ESTATE_BROKERAGE'
        : collection.matches('^fm_.*') ? 'FACILITIES_MANAGEMENT'
        : collection.matches('^rdv_.*') ? 'REAL_ESTATE_DEVELOPMENT'
        : collection.matches('^mkt_.*') ? 'MARKETING_AGENCY'
        : collection.matches('^cln_.*') ? 'MEDICAL_CLINIC'
        : collection.matches('^sch_.*') ? 'SCHOOL_MANAGEMENT'
        // Custom Business Modules Engine: runtime-created record collections
        // carry the owning activity spelled INTO the name
        // (mod_<activity_lowercase>_rec_<moduleKey>), exactly like the fixed
        // prefixes above, so a forged `activity` field stays inert and the
        // owner is always re-derived from the collection NAME. Kept in sync
        // with src/features/activities/types/activity-domain.ts.
        : collection.matches('^mod_projects_rec_.*') ? 'PROJECTS'
        : collection.matches('^mod_real_estate_management_rec_.*') ? 'REAL_ESTATE_MANAGEMENT'
        : collection.matches('^mod_real_estate_brokerage_rec_.*') ? 'REAL_ESTATE_BROKERAGE'
        : collection.matches('^mod_facilities_management_rec_.*') ? 'FACILITIES_MANAGEMENT'
        : collection.matches('^mod_real_estate_development_rec_.*') ? 'REAL_ESTATE_DEVELOPMENT'
        : collection.matches('^mod_marketing_agency_rec_.*') ? 'MARKETING_AGENCY'
        : collection.matches('^mod_medical_clinic_rec_.*') ? 'MEDICAL_CLINIC'
        : collection.matches('^mod_school_management_rec_.*') ? 'SCHOOL_MANAGEMENT'
        : '';
    }

    function isDomainCollection(collection) {
      return domainOwnerActivity(collection) != '';
    }

    // The engine's dynamic record collections (as opposed to the fixed
    // domain prefixes). Used to hold permanent deletion back to admins while
    // ordinary members keep their activity-scoped CRUD.
    function isModuleRecordCollection(collection) {
      return collection.matches('^mod_.*_rec_.*');
    }

    // Clinical and student records are the sensitive domains: least-privilege
    // is enforced on top of the activity gate so a generic clinic/school
    // employee cannot enumerate every patient/student by guessed ids.
    function isSensitiveDomainCollection(collection) {
      return collection.matches('^cln_.*') || collection.matches('^sch_.*')
        || collection.matches('^mod_medical_clinic_rec_.*')
        || collection.matches('^mod_school_management_rec_.*');
    }

    // Secure allowlist for generic tenant subcollections.
    // Prevents arbitrary collection injection and denies unknown collections by default.
    function isKnownGenericCollection(collection) {
      return collection in [
        'tasks', 'contacts', 'contact_classifications', 'projects',
        'deals', 'leads', 'customers', 'accounts', 'contracts',
        'products', 'inventory_items', 'sprints', 'leave_requests',
        'performance_reviews', 'announcements', 'work_locations', 'assets',
        'rem_properties', 'fm_assets', 'fm_work_orders',
        'mkt_campaigns', 'mkt_deliverables', 'mkt_expenses'
      ]
      || isDomainCollection(collection)
      || isModuleRecordCollection(collection);
    }

    // Authoritative tenant activity, read from the company doc on the server.
    // A missing/legacy value normalizes to PROJECTS, which owns none of the
    // reserved prefixes, so every domain collection is denied fail-closed.
    function companyAuthoritativeActivity(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId))
        .data.get('primaryActivity', 'PROJECTS');
    }

    // Mirrors isAdminRole/isManagerRole plus an explicit `domain.manage` grant
    // from src/lib/permissions.
    function hasSensitiveDomainPrivilege(companyId) {
      return belongsToCompany(companyId) && (
        isCompanyAdmin(companyId)
        || userDoc().get('role', '') == 'manager'
        || 'domain.manage' in customPermissions()
      );
    }

    // Full domain gate. Only ever evaluated when `collection` is a domain
    // collection, so shared reads pay no extra get() cost (|| short-circuits).
    function domainAccessAllowed(companyId, collection) {
      return belongsToCompany(companyId)
        && (isPlatformAdmin() || (
          companyAuthoritativeActivity(companyId) == domainOwnerActivity(collection)
          && (!isSensitiveDomainCollection(collection)
              || hasSensitiveDomainPrivilege(companyId))
        ));
    }

    // Mirrors canApproveDocuments() plus the accounting-specific Billing
    // sub-role, so the client review gate is enforced on the server too.
    function canReviewDocuments(companyId) {
      return belongsToCompany(companyId) && (
        isPlatformAdmin()
        || userDoc().get('role', '') in ['super_admin', 'admin', 'manager']
        || billingSubRole() in ['admin', 'manager', 'accountant']
        || 'billing.review_documents' in customPermissions()
      );
    }

    // Mirrors the `people.view_all_reports` permission in src/lib/permissions.
    // Everyone can always read their own reports; this covers reading everyone's.
    function canViewAllReports(companyId) {
      return belongsToCompany(companyId) && (
        isPlatformAdmin()
        || userDoc().get('role', '') in ['super_admin', 'platform_admin']
        || isGlobalHrManager(companyId)
        || 'people.view_all_reports' in customPermissions()
        || (
          userDoc().get('role', '') in ['admin', 'manager']
          && (peopleSubRole() == '' || peopleSubRole() in ['admin', 'manager', 'hr'])
        )
      );
    }

    // ---- SEC-P0-01: user-profile provisioning contract --------------------
    //
    // The users collection is the RBAC root: role/companyId/customPermissions/
    // portalSubRoles read here decide every downstream gate. The old create rule
    // (`signedIn() && uid == userId`) let ANY signed-in uid forge a privileged
    // profile — self-mint super_admin, join a victim tenant as admin, or grant
    // oneself customPermissions. These helpers encode the ONLY provisioning
    // shapes the shipped services actually perform (traced against
    // AuthService.register / loginWithGoogle / login / acceptInvite).

    // True when the not-yet-existing profile elevates itself through a portal
    // sub-role map (e.g. {billing:'accountant'} reaches canReviewDocuments).
    // Ordinary self-provisioned profiles must never carry these; invitation
    // grants are validated against the real invite doc instead.
    function portalSubRolesElevating(data) {
      return data.get('portalSubRoles', null) != null
        && data.get('portalSubRoles', {}) is map
        && data.get('portalSubRoles', {}).size() > 0;
    }

    // A self-provisioned profile may only carry customPermissions when absent or
    // empty; an admin grants them later through the separately-gated update rule.
    function customPermissionsEmptyOrAbsent(data) {
      return !(data.get('customPermissions', []) is list)
        || data.get('customPermissions', []).size() == 0;
    }

    function invitationRoleAllowed(role) {
      return role in ['employee', 'viewer', 'manager', 'global_hr_manager'];
    }

    function validPendingInvitationData(invite, token, email, companyId, role) {
      return invite.get('token', '') == token
        && invite.get('status', '') == 'pending'
        && invite.get('email', '') == email
        && invite.get('companyId', '') == companyId
        && invite.get('role', '') == role
        && invitationRoleAllowed(role)
        && invite.get('expiresAt', null) is timestamp
        && invite.expiresAt > request.time;
    }

    function pendingInvitationMatches(token, email, companyId, role) {
      return signedIn()
        && token is string
        && token != ''
        && request.auth.token.get('email', '') == email
        && exists(/databases/$(database)/documents/invites/$(token))
        && validPendingInvitationData(
          get(/databases/$(database)/documents/invites/$(token)).data,
          token,
          email,
          companyId,
          role
        );
    }

    function invitationDataMatches(invite, userId, token) {
      return request.resource.data.get('id', userId) == userId
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && request.resource.data.get('companyId', '') == invite.get('companyId', '')
        && request.resource.data.get('companyName', '') == invite.get('companyName', '')
        && request.resource.data.get('role', '') == invite.get('role', '')
        && request.resource.data.get('portalAccess', []) == invite.get('portalAccess', [])
        && request.resource.data.get('portalSubRoles', {}) == invite.get('portalSubRoles', {})
        && validPendingInvitationData(
          invite,
          token,
          request.resource.data.get('email', ''),
          request.resource.data.get('companyId', ''),
          request.resource.data.get('role', '')
        );
    }

    function invitationFieldsMatch(userId) {
      let token = request.resource.data.get('invitationToken', '');
      return request.auth.uid == userId
        && token is string
        && token != ''
        && exists(/databases/$(database)/documents/invites/$(token))
        && invitationDataMatches(
          get(/databases/$(database)/documents/invites/$(token)).data,
          userId,
          token
        );
    }

    // The first profile write is inert and grants no tenant access. Completion
    // is only authorized in the same batch that links one employee record and
    // consumes the pending invitation.
    function provisionedViaValidInvitation() {
      return request.resource.data.get('onboardingStatus', '') == 'pending'
        && invitationFieldsMatch(request.auth.uid);
    }

    function completedInvitationProfile(userId) {
      let token = request.resource.data.get('invitationToken', '');
      let invite = get(/databases/$(database)/documents/invites/$(token)).data;
      let inviteAfter = getAfter(/databases/$(database)/documents/invites/$(token)).data;
      let employeeId = inviteAfter.get('employeeId', '');
      let employee = getAfter(
        /databases/$(database)/documents/companies/$(invite.get('companyId', ''))/employees/$(employeeId)
      ).data;
      return request.auth.uid == userId
        && resource.data.get('onboardingStatus', '') == 'pending'
        && request.resource.data.get('onboardingStatus', '') == 'active'
        && request.resource.data.get('invitationToken', '') == resource.data.get('invitationToken', '')
        && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
        && request.resource.data.get('companyName', '') == invite.get('companyName', '')
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && request.resource.data.get('portalAccess', []) == invite.get('portalAccess', [])
        && request.resource.data.get('portalSubRoles', {}) == invite.get('portalSubRoles', {})
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && request.resource.data.get('customPermissions', []) == resource.data.get('customPermissions', [])
        && validPendingInvitationData(
          invite,
          token,
          request.resource.data.get('email', ''),
          request.resource.data.get('companyId', ''),
          request.resource.data.get('role', '')
        )
        && inviteAfter.get('status', '') == 'accepted'
        && inviteAfter.get('acceptedBy', '') == request.auth.uid
        && inviteAfter.get('employeeId', '') != ''
        && employee.get('userId', '') == request.auth.uid
        && employee.get('email', '') == request.auth.token.get('email', '')
        && employee.get('companyId', '') == invite.get('companyId', '')
        && employee.get('role', '') == invite.get('role', '');
    }

    function pendingInviteeForCompany(companyId) {
      return signedIn()
        && hasUserDoc()
        && userDoc().get('onboardingStatus', '') == 'pending'
        && userDoc().get('companyId', '') == companyId
        && pendingInvitationMatches(
          userDoc().get('invitationToken', ''),
          request.auth.token.get('email', ''),
          companyId,
          userDoc().get('role', '')
        );
    }

    // User profiles
    match /users/{userId} {
      // Own profile, or teammates in the same company. Every stored-field read
      // uses `.get(key, default)` so a partial/malformed profile (a users doc
      // that predates `companyId`, or was written by an interrupted signup)
      // yields a clean FALSE instead of a hard "Property is undefined" rules
      // ERROR, which would otherwise break the whole team-roster listener.
      allow get: if signedIn() && (
        isPlatformAdmin()
        || request.auth.uid == userId
        || (
          hasUserDoc()
          && resource.data.get('companyId', '') != ''
          && resource.data.get('companyId', '') == userDoc().get('companyId', '')
        )
      );

      // Roster listing inside the caller's own company (unchanged), plus a
      // deliberate account-reconciliation capability: a platform super_admin may
      // list ONLY unassigned accounts (companyId == '') — the orphans surfaced
      // once login() stopped grafting a fabricated tenant — so they can be
      // reviewed and assigned. Pinned to the empty-tenant docs and the
      // super_admin role, so no tenant roster is newly exposed.
      // Platform admin can list all user profiles across the entire platform.
      allow list: if signedIn() && (
        isPlatformAdmin()
        || (
          hasUserDoc()
          && resource.data.get('companyId', '') != ''
          && resource.data.get('companyId', '') == userDoc().get('companyId', '')
        )
        || (isSuperAdmin() && resource.data.get('companyId', '') == '')
      );

      // New account. Only the four real provisioning shapes are allowed, and
      // never a client-minted super_admin, platform_admin, or self-granted customPermissions.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', '') != 'super_admin'
        && request.resource.data.get('role', '') != 'platform_admin'
        && customPermissionsEmptyOrAbsent(request.resource.data)
        && (
          // (1) Invitation-backed: the only legitimate way to be provisioned
          //     into an EXISTING tenant with a privileged role or portal sub-roles.
          provisionedViaValidInvitation()
          // (2) Ordinary self-provisioning (login() orphan placeholder, plain
          //     member joining): never elevated, never a tenant administrator.
          || (request.resource.data.get('role', '') in ['employee', 'viewer']
              && request.resource.data.get('companyId', '') == ''
              && !portalSubRolesElevating(request.resource.data))
          // (3) New-tenant onboarding (register / loginWithGoogle): admin of a
          //     company that does NOT exist yet, so a caller can only stand up
          //     their own tenant — never inject themselves into someone else's.
          || (request.resource.data.get('role', '') == 'admin'
              && request.resource.data.get('companyId', '') != ''
              && !exists(/databases/$(database)/documents/companies/$(request.resource.data.get('companyId', '')))
              && !portalSubRolesElevating(request.resource.data))
        );

      // Self update (without privilege escalation), or company admin updating teammates,
      // or Platform Admin managing any user across any company.
      // Plus reconciliation assignment: a platform super_admin may attach an
      // UNASSIGNED (companyId == '') profile to a real company — the write must
      // set a non-empty companyId, so this branch can only consume orphans, never
      // move an existing tenant's member.
      allow update: if resource != null && signedIn() && (
        (
          request.auth.uid == userId
          && (
            // Platform admins retain their existing self-profile restrictions.
            (isPlatformAdmin()
              && request.resource.data.get('role', '') == resource.data.get('role', '')
              && (resource.data.get('role', '') != 'super_admin'
                || request.resource.data.get('role', '') == 'super_admin'))
            || (
              resource.data.get('role', '') != 'platform_admin'
              && request.resource.data.get('role', '') == resource.data.get('role', '')
              && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
              && request.resource.data.get('customPermissions', []) == resource.data.get('customPermissions', [])
              && request.resource.data.get('portalSubRoles', {}) == resource.data.get('portalSubRoles', {})
              && request.resource.data.get('portalAccess', []) == resource.data.get('portalAccess', [])
              && request.resource.data.get('countryScope', []) == resource.data.get('countryScope', [])
              && request.resource.data.get('onboardingStatus', '') == resource.data.get('onboardingStatus', '')
            )
            // Invitation-backed self-update: existing user accepting a valid pending invitation.
            || (
              request.resource.data.get('onboardingStatus', '') == 'pending'
              && request.resource.data.get('invitationToken', '') is string
              && request.resource.data.get('invitationToken', '') != ''
              && provisionedViaValidInvitation()
              && (resource.data.get('companyId', '') == ''
                || resource.data.get('companyId', '') == request.resource.data.get('companyId', ''))
              && request.resource.data.get('customPermissions', []) == resource.data.get('customPermissions', [])
            )
            || (
              resource.data.get('onboardingStatus', '') == 'pending'
              && request.resource.data.get('onboardingStatus', '') == 'active'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasAll(['onboardingStatus', 'updatedAt'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['onboardingStatus', 'updatedAt'])
              && completedInvitationProfile(userId)
            )
            || (
              isSuperAdmin()
              && resource.data.get('companyId', '') == ''
              && request.resource.data.get('companyId', '') != ''
            )
          )
        )
        || (
          request.auth.uid != userId
          && (
            // Platform Administrator: comprehensive management across all companies and users.
            (isPlatformAdmin()
              && (request.resource.data.get('role', '') == resource.data.get('role', ''))
              && (resource.data.get('role', '') != 'super_admin'
                || request.resource.data.get('role', '') == 'super_admin'))
            // Company-admin teammate management with privilege-escalation guards.
            || (hasUserDoc() && isCompanyAdmin(resource.data.get('companyId', ''))
              && resource.data.get('role', '') != 'platform_admin'
              && request.resource.data.get('role', '') != 'platform_admin'
              && (isSuperAdmin() || (
                resource.data.get('role', '') != 'super_admin'
                && request.resource.data.get('role', '') != 'super_admin'
              ))
              && request.resource.data.get('companyId', '') == resource.data.get('companyId', ''))
            || (
              hasUserDoc() && isGlobalHrManager(resource.data.get('companyId', ''))
              && resource.data.get('role', '') in ['employee', 'viewer']
              && request.resource.data.get('role', '') in ['employee', 'viewer']
              && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
              && request.resource.data.get('customPermissions', []) == resource.data.get('customPermissions', [])
              && request.resource.data.get('portalSubRoles', {}) == resource.data.get('portalSubRoles', {})
              && request.resource.data.get('portalAccess', []) == resource.data.get('portalAccess', [])
              && request.resource.data.get('countryScope', []) == resource.data.get('countryScope', [])
              && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
            )
          )
        )
      );

      // User account deletion guards:
      // - Platform Admin CANNOT delete own user identity (prevents accidental lockout)
      // - Platform Admin CANNOT delete super_admin identity (governance separation)
      // - Company Admin CANNOT delete own user identity, platform_admin, or super_admin
      allow delete: if (
        isPlatformAdmin()
        && request.auth.uid != userId
        && resource.data.get('role', '') != 'super_admin'
      )
      || (
        hasUserDoc() && isCompanyAdmin(resource.data.get('companyId', ''))
        && request.auth.uid != userId
        && resource.data.get('role', '') != 'platform_admin'
        && resource.data.get('role', '') != 'super_admin'
      );
    }

    // Team invitations (token = document id)
    match /invites/{token} {
      function acceptedByInvitee() {
        let invite = resource.data;
        let profile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let employeeId = request.resource.data.get('employeeId', '');
        let employee = getAfter(
          /databases/$(database)/documents/companies/$(invite.get('companyId', ''))/employees/$(employeeId)
        ).data;
        return signedIn()
          && invite.get('token', '') == token
          && invite.get('status', '') == 'pending'
          && invite.get('email', '') == request.auth.token.get('email', '')
          && invite.get('expiresAt', null) is timestamp
          && invite.expiresAt > request.time
          && request.resource.data.get('status', '') == 'accepted'
          && request.resource.data.get('acceptedBy', '') == request.auth.uid
          && request.resource.data.get('acceptedAt', null) is timestamp
          && employeeId is string
          && employeeId != ''
          && (!('employeeId' in invite) || invite.employeeId == employeeId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'acceptedBy', 'employeeId'])
          && profile.get('id', '') == request.auth.uid
          && profile.get('email', '') == request.auth.token.get('email', '')
          && profile.get('companyId', '') == invite.get('companyId', '')
          && profile.get('role', '') == invite.get('role', '')
          && profile.get('invitationToken', '') == token
          && profile.get('onboardingStatus', '') == 'active'
          && employee.get('userId', '') == request.auth.uid
          && employee.get('email', '') == invite.get('email', '')
          && employee.get('companyId', '') == invite.get('companyId', '')
          && employee.get('role', '') == invite.get('role', '');
      }

      // Accept page loads a single pending invite by token (pre-auth).
      allow get: if (
        resource.data.get('status', '') == 'pending'
        && resource.data.get('token', '') == token
        && resource.data.get('expiresAt', null) is timestamp
        && resource.data.expiresAt > request.time
      )
        || (signedIn() && (isPlatformAdmin() || isCompanyAdmin(resource.data.get('companyId', '')) || isGlobalHrManager(resource.data.get('companyId', ''))));

      // Admins and Global HR Managers list pending invites for their company (query must filter companyId).
      // The LIST gate reads each candidate doc, so the per-doc companyId is taken
      // through `.get()` to avoid an evaluation error on a malformed invite.
      allow list: if signedIn() && (isPlatformAdmin() || isCompanyAdmin(resource.data.get('companyId', '')) || isGlobalHrManager(resource.data.get('companyId', '')));

      allow create: if signedIn()
        && (isPlatformAdmin() || isCompanyAdmin(request.resource.data.get('companyId', '')) || isGlobalHrManager(request.resource.data.get('companyId', '')))
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('email', 0) is string
        && request.resource.data.get('token', '') == token
        && request.resource.data.get('expiresAt', null) is timestamp
        && request.resource.data.expiresAt > request.time
        && invitationRoleAllowed(request.resource.data.get('role', ''))
        && (isPlatformAdmin() || isCompanyAdmin(request.resource.data.get('companyId', '')) || (
          request.resource.data.get('role', '') in ['employee', 'viewer']
          && !portalSubRolesElevating(request.resource.data)
          && customPermissionsEmptyOrAbsent(request.resource.data)
        ));

      allow update: if signedIn() && (
        isCompanyAdmin(resource.data.get('companyId', ''))
        || (
          isGlobalHrManager(resource.data.get('companyId', ''))
          && resource.data.get('role', '') in ['employee', 'viewer']
          && request.resource.data.get('role', '') in ['employee', 'viewer']
          && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
          && request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
          && !portalSubRolesElevating(request.resource.data)
          && customPermissionsEmptyOrAbsent(request.resource.data)
        )
        || (
          acceptedByInvitee()
        )
      );

      allow delete: if signedIn() && (
        isCompanyAdmin(resource.data.get('companyId', ''))
        || (isGlobalHrManager(resource.data.get('companyId', '')) && resource.data.get('role', '') in ['employee', 'viewer'])
      );
    }

    // OTP password-reset codes - secure against public enumeration and tampering.
    match /otpResets/{id} {
      allow read, write: if false;
    }

    // Public invoice PDF shares (QR scan → PDF). No auth required to open.
    match /publicInvoiceShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.token == token
        && request.resource.data.companyId is string
        && request.resource.data.invoiceId is string
        && belongsToCompany(request.resource.data.companyId)
        && (
          request.resource.data.snapshot is map
          || request.resource.data.pdfUrl is string
          || request.resource.data.pdfBase64 is string
        );
      allow update: if signedIn()
        && request.resource.data.token == token
        && resource.data.companyId is string
        && request.resource.data.companyId == resource.data.companyId
        && belongsToCompany(resource.data.companyId)
        && (
          request.resource.data.snapshot is map
          || request.resource.data.pdfUrl is string
          || request.resource.data.pdfBase64 is string
        );
      allow delete: if signedIn()
        && resource.data.companyId is string
        && belongsToCompany(resource.data.companyId);
    }

    // Platform Audit Logs: Append-only, immutable audit trail for platform-wide events.
    // Enforces actor authenticity (actorUid must match request.auth.uid) to prevent client-side forgery.
    match /audit_logs/{logId} {
      allow read: if signedIn() && (isPlatformAdmin() || isSuperAdmin());
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    match /companies/{companyId} {
      allow get: if belongsToCompany(companyId);
      allow list: if isPlatformAdmin();
      // Company profile updates stay open to company members EXCEPT for the
      // primaryActivity field, which only a company admin may change and only
      // to a registry-known stable id. The browser's selected activity is
      // never trusted: this is the authoritative write boundary.
      allow update: if belongsToCompany(companyId)
        && validPrimaryActivity(request.resource.data)
        && (isCompanyAdmin(companyId) || primaryActivityUnchanged());
      allow delete: if belongsToCompany(companyId) && isCompanyAdmin(companyId);
      allow create: if signedIn() && validPrimaryActivity(request.resource.data);

      // Tenant Audit Logs: Append-only, immutable audit trail for tenant actions.
      // Enforces actor authenticity to prevent client-side impersonation.
      match /audit_logs/{logId} {
        allow read: if belongsToCompany(companyId) && (isCompanyAdmin(companyId) || isPlatformAdmin());
        allow create: if belongsToCompany(companyId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.action is string;
        allow update, delete: if false;
      }

      // Allow public unauthenticated single GET for client reports (direct share link)
      match /client_reports/{reportId} {
        allow get: if true;
        allow list, write: if belongsToCompany(companyId);
      }

      // Daily reports are private: authors see their own, managers/HR/admins see all.
      // A list query is only permitted when it is filtered to the caller, which is
      // exactly what DailyReportsService does for non-privileged users.
      // `resource == null` passes only the empty-collection LIST gate probe; every
      // returned document is still evaluated against the full condition.
      match /daily_reports/{reportId} {
        allow read: if belongsToCompany(companyId) && (
          resource.data.get('employeeId', '') == request.auth.uid
          || canViewAllReports(companyId)
        );
        allow create: if belongsToCompany(companyId)
          && request.resource.data.get('employeeId', '') == request.auth.uid;
        // Authors may amend their own report; managers add the review fields.
        allow update: if belongsToCompany(companyId) && (
          resource.data.get('employeeId', '') == request.auth.uid
          || canViewAllReports(companyId)
        );
        allow delete: if isCompanyAdmin(companyId);
      }

      // Conversations & Chat channels: protect private channels and DMs
      match /conversations/{conversationId} {
        // Every branch reads `type`/`visibility`/`memberIds` through
        // `.get(key, default)` so one legacy/malformed doc evaluates to false
        // instead of ERRORing out the whole chat subscription query. Access
        // semantics are unchanged: public channels are open to the company,
        // non-public channels require public visibility, DMs to their members,
        // and admins see everything.
        allow read: if belongsToCompany(companyId) && (
          resource.data.get('type', '') == 'public'
          || (resource.data.get('type', '') == 'channel' && resource.data.get('visibility', 'public') == 'public')
          || (resource.data.get('memberIds', []) is list && request.auth.uid in resource.data.get('memberIds', []))
          || isCompanyAdmin(companyId)
        );
        allow create: if belongsToCompany(companyId);
        allow update: if belongsToCompany(companyId) && (
          ('memberIds' in resource.data && resource.data.memberIds is list && request.auth.uid in resource.data.memberIds)
          || isCompanyAdmin(companyId)
        );
        allow delete: if isCompanyAdmin(companyId);

        match /messages/{messageId} {
          function parentConversation() {
            return get(/databases/$(database)/documents/companies/$(companyId)/conversations/$(conversationId)).data;
          }

          function canAccessParent() {
            return belongsToCompany(companyId) && (
              parentConversation().get('type', '') == 'public'
              || (parentConversation().get('type', '') == 'channel' && parentConversation().get('visibility', 'public') == 'public')
              || (parentConversation().get('memberIds', []) is list && request.auth.uid in parentConversation().get('memberIds', []))
              || isCompanyAdmin(companyId)
            );
          }

          allow read: if canAccessParent();
          allow create: if canAccessParent()
            && request.resource.data.senderId == request.auth.uid;
          allow update: if canAccessParent() && (
            resource.data.get('senderId', '') == request.auth.uid
            || isCompanyAdmin(companyId)
          );
          allow delete: if canAccessParent() && (
            resource.data.get('senderId', '') == request.auth.uid
            || isCompanyAdmin(companyId)
          );
        }
      }

      // Accounting General Ledger journals: Immutable audit trail once posted.
      // Must have balanced debits and credits; updates and deletions are prohibited to prevent tampering.
      match /journals/{journalId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId)
          && !isGlobalHrManager(companyId)
          && request.resource.data.totalDebit == request.resource.data.totalCredit
          && request.resource.data.totalDebit > 0;
        allow update, delete: if false;
      }

      // Payments: Permanent financial transaction records; deletions are prohibited.
      match /payments/{paymentId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId)
          && !isGlobalHrManager(companyId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if false;
      }

      // Vouchers: Payment & Receipt vouchers (strictly isolated from HR operations).
      // Only Company Admins and Platform Admins can issue vouchers. Amount must be positive.
      match /vouchers/{voucherId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if (isCompanyAdmin(companyId) || isPlatformAdmin())
          && !isGlobalHrManager(companyId)
          && (
            (request.resource.data.get('amount', 0) is number && request.resource.data.get('amount', 0) > 0)
            || (request.resource.data.get('totalAmount', 0) is number && request.resource.data.get('totalAmount', 0) > 0)
          );
        allow delete: if false;
      }

      // Payroll payments/disbursements (execution isolated from HR).
      // Only Company Admins and Platform Admins can execute payroll disbursements. Amount must be positive.
      match /payroll_payments/{paymentId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if (isCompanyAdmin(companyId) || isPlatformAdmin())
          && !isGlobalHrManager(companyId)
          && (
            (request.resource.data.get('amount', 0) is number && request.resource.data.get('amount', 0) > 0)
            || (request.resource.data.get('totalDisbursement', 0) is number && request.resource.data.get('totalDisbursement', 0) > 0)
          );
        allow delete: if false;
      }

      // Employees: Sensitive HR personnel records.
      // Global HR and Company Admins can manage; deletion is restricted to Company Admins and Platform Admins.
      match /employees/{employeeId} {
        function acceptedInvitationEmployeeLink() {
          let profile = getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data;
          let token = profile.get('invitationToken', '');
          let invite = get(/databases/$(database)/documents/invites/$(token)).data;
          let inviteAfter = getAfter(
            /databases/$(database)/documents/invites/$(token)
          ).data;
          return signedIn()
            && profile.get('id', '') == request.auth.uid
            && profile.get('email', '') == request.auth.token.get('email', '')
            && profile.get('companyId', '') == companyId
            && profile.get('role', '') == invite.get('role', '')
            && profile.get('onboardingStatus', '') == 'active'
            && validPendingInvitationData(
              invite,
              token,
              request.auth.token.get('email', ''),
              companyId,
              profile.get('role', '')
            )
            && inviteAfter.get('status', '') == 'accepted'
            && inviteAfter.get('acceptedBy', '') == request.auth.uid
            && inviteAfter.get('employeeId', '') == employeeId
            && request.resource.data.get('userId', '') == request.auth.uid
            && request.resource.data.get('email', '') == invite.get('email', '')
            && request.resource.data.get('companyId', '') == companyId
            && request.resource.data.get('role', '') == invite.get('role', '');
        }

        allow get: if belongsToCompany(companyId)
          || isGlobalHrManager(companyId)
          || (
            pendingInviteeForCompany(companyId)
            && resource.data.get('email', '') == request.auth.token.get('email', '')
          );
        allow list: if belongsToCompany(companyId)
          || isGlobalHrManager(companyId)
          || (
            pendingInviteeForCompany(companyId)
            && resource.data.get('email', '') == request.auth.token.get('email', '')
          );
        allow create: if isCompanyAdmin(companyId)
          || isPlatformAdmin()
          || isGlobalHrManager(companyId)
          || (
            acceptedInvitationEmployeeLink()
            && request.resource.data.keys().hasOnly([
              'id', 'userId', 'companyId', 'email', 'name',
              'firstName', 'lastName', 'role', 'status', 'workMode',
              'createdAt', 'updatedAt'
            ])
            && request.resource.data.get('workMode', 'remote') == 'remote'
          );
        allow update: if isCompanyAdmin(companyId)
          || isPlatformAdmin()
          || isGlobalHrManager(companyId)
          || (
            resource.data.get('userId', '') in ['', request.auth.uid]
            &&
            acceptedInvitationEmployeeLink()
            && resource.data.get('email', '') == request.auth.token.get('email', '')
            && resource.data.get('companyId', '') == companyId
            && resource.data.get('role', '') == request.resource.data.get('role', '')
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userId', 'updatedAt'])
          );
        // Self-service attendance status: the account linked to an employee
        // record may flip ONLY its own shiftStatus (working/on-break/off-duty)
        // plus the updatedAt stamp when punching in/out or taking a break.
        // Ownership is proven by the record's userId matching the caller and
        // tenant isolation by belongsToCompany; the diff whitelist keeps every
        // identity, role, tenant and compensation field immutable. This restores
        // the punch capability the employees catch-all exclusion removed, without
        // reopening cross-employee or cross-company writes.
        allow update: if belongsToCompany(companyId)
          && resource != null
          && resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('shiftStatus', '') in ['working', 'on-break', 'off-duty']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['shiftStatus', 'updatedAt']);
        allow delete: if isCompanyAdmin(companyId) || isPlatformAdmin();
      }

      // Invoices: Company client billing and receivables.
      // Modifications and deletions are strictly restricted to Company Admins and Platform Admins.
      match /invoices/{invoiceId} {
        allow read: if belongsToCompany(companyId) || isPlatformAdmin();
        allow create, update: if isCompanyAdmin(companyId) || isPlatformAdmin();
        allow delete: if isCompanyAdmin(companyId) || isPlatformAdmin();
      }

      // Vendor bills are the canonical expense records. Any company member may
      // RECORD/edit a bill (a recorded cost is not yet an approved actual), but
      // only a document reviewer may set the accountant review outcome
      // (approvalStatus -> approved/rejected). Without this, the client
      // canApproveDocuments gate could be bypassed by writing the field directly.
      match /bills/{billId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId) && (
          canReviewDocuments(companyId)
          || (
            request.resource.data.get('approvalStatus', 'pending') != 'approved'
            && request.resource.data.get('approvalStatus', 'pending') != 'rejected'
          )
        );
        // `resource != null` keeps UPDATE semantics; without it the clause
        // ERRORs while the emulator evaluates a create, silently denying the
        // non-reviewer branch below.
        allow update: if belongsToCompany(companyId) && resource != null && (
          canReviewDocuments(companyId)
          || request.resource.data.get('approvalStatus', '') == resource.data.get('approvalStatus', '')
        );
        allow delete: if isCompanyAdmin(companyId);
      }

      // ---- REAL_ESTATE_MANAGEMENT financial least-privilege -------------------
      //
      // Mirrors the real_estate.* grants in src/lib/permissions: super_admin/admin
      // and manager roles hold the financial permissions implicitly; any other
      // role needs an explicit customPermissions entry. Enforced in rules so a
      // client can never mark installments paid, record/void a rent payment,
      // refund a deposit, or activate/terminate a lease by writing Firestore
      // directly (the UI gates are not the boundary).
      function hasRemPermission(companyId, permission) {
        return belongsToCompany(companyId) && (
          isCompanyAdmin(companyId)
          || userDoc().get('role', '') == 'manager'
          || permission in customPermissions()
        );
      }
      
      // Lease states that create or end binding financial obligations. Moving a
      // lease into one of them must go through the approve permission; drafts,
      // expiring markers and renewals do not.
      function remLeaseStateEscalates(data) {
        return data.get('status', '') in ['active', 'terminated', 'cancelled']
          && !(hasRemPermission(companyId, 'real_estate.approve'));
      }
      
      // Lease lifecycle legality, enforced on the SERVER from the CURRENT status
      // (resource.data.status) to the proposed one (request.resource.data.status).
      // Mirrors LEASE_TRANSITIONS in src/features/real-estate/lib/rem-rules.ts so a
      // lease can NEVER be resurrected from a terminal state, while every legitimate
      // lifecycle edge — including expiring -> active restored by the due-date
      // processor — and ordinary metadata edits (status unchanged) remain allowed.
      function remLeaseEdgeAllowed(from, to) {
        return (
          (from == 'draft' && to in ['pending_approval', 'active', 'cancelled'])
          || (from == 'pending_approval' && to in ['active', 'draft', 'cancelled'])
          || (from == 'active' && to in ['expiring', 'expired', 'terminated', 'renewed'])
          || (from == 'expiring' && to in ['expired', 'terminated', 'renewed', 'active'])
          || (from == 'expired' && to in ['renewed', 'terminated'])
        );
      }

      // REM code counters live in settings/real_estate.sequences and are bumped
      // inside allocateRemCode's transaction (merge set, so request.resource.data
      // reflects the whole merged doc — untouched kinds stay equal, the allocated
      // kind grows by one). A counter may therefore only ever move FORWARD: a
      // rewind is exactly the mechanism behind duplicate property/lease codes, so
      // it is denied here while legitimate generation stays allowed.
      function remSeqNotRewound(kind) {
        return request.resource.data.get('sequences', {}).get(kind, {}).get('nextNumber', 0)
          >= resource.data.get('sequences', {}).get(kind, {}).get('nextNumber', 0);
      }

      function remSequenceNotRewound() {
        return remSeqNotRewound('property')
          && remSeqNotRewound('building')
          && remSeqNotRewound('unit')
          && remSeqNotRewound('lease')
          && remSeqNotRewound('inspection');
      }

      // Leases: never hard-deletable — terminated/expired history must survive.
      match /rem_leases/{leaseId} {
        allow read: if domainAccessAllowed(companyId, 'rem_leases');
        allow create: if domainAccessAllowed(companyId, 'rem_leases')
          && request.resource.data.get('status', '') in ['draft', 'pending_approval', 'active']
          && !remLeaseStateEscalates(request.resource.data);
        allow update: if domainAccessAllowed(companyId, 'rem_leases')
          && !remLeaseStateEscalates(request.resource.data)
          && (
            request.resource.data.get('status', '') == resource.data.get('status', '')
            || remLeaseEdgeAllowed(resource.data.get('status', ''), request.resource.data.get('status', ''))
          );
        allow delete: if false;
      }
      
      // Rent installments: the schedule is durable; only the collect workflow
      // may move status/paidAmount. Other metadata edits stay available to the
      // domain, and deletion is never allowed (financial history preservation).
      match /rem_rent_installments/{installmentId} {
        allow read: if domainAccessAllowed(companyId, 'rem_rent_installments');
        // Schedule generation opens every period UNCOLLECTED (paidAmount 0); a
        // fabricated collected amount at creation is rejected — money only ever
        // lands through the collect-gated UPDATE below (or the trusted callable).
        allow create: if domainAccessAllowed(companyId, 'rem_rent_installments')
          && request.resource.data.get('paidAmount', 0) == 0;
        allow update: if domainAccessAllowed(companyId, 'rem_rent_installments') && (
          hasRemPermission(companyId, 'real_estate.collect')
          || (
            request.resource.data.get('status', '') == resource.data.get('status', '')
            && request.resource.data.get('paidAmount', 0) == resource.data.get('paidAmount', 0)
          )
        );
        allow delete: if false;
      }
      
      // Rent payments/allocations: only the collect permission may record or
      // void (correction) a payment; documents are never deletable, preserving
      // the audit trail of voided-but-recorded transactions.
      match /rem_rent_payments/{paymentId} {
        allow read: if domainAccessAllowed(companyId, 'rem_rent_payments');
        // Only the collect permission records a payment, the amount must be a
        // positive number, and the actor is bound to the authenticated uid (a
        // forged createdBy is rejected) — mirrors the shared `payments` amount gate.
        allow create: if domainAccessAllowed(companyId, 'rem_rent_payments')
          && hasRemPermission(companyId, 'real_estate.collect')
          && request.resource.data.get('amount', 0) > 0
          && request.resource.data.get('createdBy', '') == request.auth.uid;
        // The only legitimate UPDATE is the void/correction: void flags + reason
        // may change, but the money fields (amount, allocations, lease, actor) are
        // immutable, so a collector can never rewrite a recorded payment's total.
        allow update: if domainAccessAllowed(companyId, 'rem_rent_payments')
          && hasRemPermission(companyId, 'real_estate.collect')
          && resource != null
          && request.resource.data.get('amount', 0) == resource.data.get('amount', 0)
          && request.resource.data.get('allocations', []) == resource.data.get('allocations', [])
          && request.resource.data.get('leaseId', '') == resource.data.get('leaseId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
        allow delete: if false;
      }
      
      // Security deposits: refund/deduction/forfeiture transitions require the
      // dedicated deposits permission; expected-deposit registration is open to
      // the domain alongside the lease. No hard deletes.
      match /rem_security_deposits/{depositId} {
        allow read: if domainAccessAllowed(companyId, 'rem_security_deposits');
        allow create: if domainAccessAllowed(companyId, 'rem_security_deposits');
        allow update: if domainAccessAllowed(companyId, 'rem_security_deposits')
          && hasRemPermission(companyId, 'real_estate.deposits');
        allow delete: if false;
      }

      // Property expenses are the domain's canonical expense records. Recording a
      // cost is open to the domain, but the accountant review outcome
      // (approvalStatus -> approved/rejected) and any rewrite of an APPROVED
      // amount require the real_estate.approve atom — mirroring the shared `bills`
      // gate so a client can neither self-approve nor quietly amend an approved
      // expense. The actor is bound to the authenticated uid. Hard deletion is
      // denied (the UI archives instead); financial history is preserved.
      match /rem_property_expenses/{expenseId} {
        allow read: if domainAccessAllowed(companyId, 'rem_property_expenses');
        allow create: if domainAccessAllowed(companyId, 'rem_property_expenses')
          && request.resource.data.get('amount', 0) > 0
          && request.resource.data.get('createdBy', '') == request.auth.uid
          && (
            hasRemPermission(companyId, 'real_estate.approve')
            || (
              request.resource.data.get('approvalStatus', 'pending') != 'approved'
              && request.resource.data.get('approvalStatus', 'pending') != 'rejected'
            )
          );
        // `resource != null` keeps UPDATE semantics (same footgun as `bills`).
        allow update: if domainAccessAllowed(companyId, 'rem_property_expenses')
          && resource != null && (
            hasRemPermission(companyId, 'real_estate.approve')
            || (
              // Non-reviewers never move the approval outcome, and never rewrite
              // the money of an already-approved expense.
              request.resource.data.get('approvalStatus', '') == resource.data.get('approvalStatus', '')
              && (
                resource.data.get('approvalStatus', '') != 'approved'
                || request.resource.data.get('amount', 0) == resource.data.get('amount', 0)
              )
            )
          );
        allow delete: if false;
      }
      
      // Every other company subcollection stays open to company members.
      // Rules are additive, so explicit collections are excluded by name here.
      // Activity-owned domain collections (reserved prefixes) are additionally
      // gated by the tenant's authoritative activity + least-privilege; shared
      // collections short-circuit past the domain check and pay no extra read.

      // ---- Work schedules, attendance & lateness-deduction boundary ----------
      //
      // Mirrors hasEffectivePermission for the new people.* atoms exactly:
      // super_admin/admin hold everything; a manager-role user only gets the
      // atoms that ROLE_PERMISSIONS.manager AND their People sub-role both
      // contain (empty sub-role = default 'manager'); anyone may receive an
      // explicit customPermissions grant. Everything else is fail-closed.
      function peopleHrAllowed(companyId, permission) {
        return belongsToCompany(companyId) && (
          isCompanyAdmin(companyId)
          || isGlobalHrManager(companyId)
          || permission in customPermissions()
          || (
            userDoc().get('role', '') == 'manager'
            && (
              (
                (peopleSubRole() == '' || peopleSubRole() in ['admin', 'manager'])
                && permission in [
                  'people.view_schedules',
                  'people.manage_schedules',
                  'people.view_all_attendance',
                  'people.correct_attendance',
                  'people.view_lateness',
                  'people.evaluate_lateness',
                  'people.decide_deductions'
                ]
              )
              || (
                peopleSubRole() == 'hr'
                && permission in [
                  'people.view_schedules',
                  'people.manage_schedules',
                  'people.view_all_attendance',
                  'people.correct_attendance',
                  'people.view_lateness',
                  'people.evaluate_lateness'
                ]
              )
            )
          )
        );
      }

      // The account (if any) behind an employee record — '' when unclaimed.
      function employeeAccountUid(employeeId) {
        return employeeId != '' && exists(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId))
          ? get(/databases/$(database)/documents/companies/$(companyId)/employees/$(employeeId)).data.get('userId', '')
          : '';
      }

      function isMyAttendance(data) {
        return signedIn() && (
          data.get('userId', '') == request.auth.uid
          || employeeAccountUid(data.get('employeeId', '')) == request.auth.uid
        );
      }

      // Stricter gate for CREATE: an employee opening a shift MUST be the
      // account behind the employee record. The old OR with data.userId alone
      // let anyone punch for any employeeId by stamping their own uid.
      function isOwnAttendanceCreate(data) {
        return signedIn()
          && employeeAccountUid(data.get('employeeId', '')) == request.auth.uid
          && (data.get('userId', '') == '' || data.get('userId', '') == request.auth.uid);
      }

      // Schedule configuration is transparent to the company; only holders of
      // people.manage_schedules may change it. Templates are deactivated, not
      // deleted — snapshots already reference them.
      match /hr_schedule_templates/{templateId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if peopleHrAllowed(companyId, 'people.manage_schedules');
        allow delete: if false;
      }

      match /hr_schedule_assignments/{assignmentId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if peopleHrAllowed(companyId, 'people.manage_schedules');
        allow delete: if false;
      }

      // Employees must be able to read the policy lateness is judged under —
      // transparency, not privilege.
      match /hr_lateness_policies/{policyId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if peopleHrAllowed(companyId, 'people.manage_lateness_policies');
        allow delete: if belongsToCompany(companyId) && (
          isCompanyAdmin(companyId)
          || 'people.manage_lateness_policies' in customPermissions()
        );
      }

      // Deduction cases: only HR/management sees the workflow; the subject
      // always sees their own. Identity fields and the frozen policy snapshot
      // are immutable — decisions record, they never rewrite. A subject can
      // NEVER decide or post against their own case, whatever their role.
      function caseSubjectUid(data) {
        return data.get('subjectUserId', '') != ''
          ? data.get('subjectUserId', '')
          : employeeAccountUid(data.get('employeeId', ''));
      }

      match /hr_deduction_cases/{caseId} {
        allow read: if belongsToCompany(companyId) && (
          peopleHrAllowed(companyId, 'people.view_lateness')
          || (resource != null && caseSubjectUid(resource.data) == request.auth.uid)
        );
        allow create: if peopleHrAllowed(companyId, 'people.evaluate_lateness')
          && request.resource.data.get('status', '') in ['pending_review', 'proposed'];
        allow update: if peopleHrAllowed(companyId, 'people.evaluate_lateness') && resource != null && (
          // identity + frozen snapshot never change
          request.resource.data.get('employeeId', '') == resource.data.get('employeeId', '')
          && request.resource.data.get('periodKey', '') == resource.data.get('periodKey', '')
          && request.resource.data.get('thresholdId', '') == resource.data.get('thresholdId', '')
          && request.resource.data.get('policyId', '') == resource.data.get('policyId', '')
          && request.resource.data.get('policySnapshot', {}) == resource.data.get('policySnapshot', {})
          && caseSubjectUid(resource.data) != request.auth.uid
          // recalculation keeps the status and only ever touches open cases
          && request.resource.data.get('status', '') == resource.data.get('status', '')
          && resource.data.get('status', '') in ['pending_review', 'proposed']
          // no posting money through a recalculation
          && request.resource.data.get('journalId', '') == resource.data.get('journalId', '')
        );
        // Decisions (approve/reject) go through the decide atom, never on the
        // subject's own case, always with the decider recorded, and only on
        // cases that are still open for a decision.
        allow update: if peopleHrAllowed(companyId, 'people.decide_deductions') && resource != null &&
          resource.data.get('status', '') in ['pending_review', 'proposed'] &&
          request.resource.data.get('status', '') in ['approved', 'rejected'] &&
          request.resource.data.get('decidedBy', '') == request.auth.uid &&
          caseSubjectUid(resource.data) != request.auth.uid &&
          request.resource.data.get('employeeId', '') == resource.data.get('employeeId', '') &&
          request.resource.data.get('periodKey', '') == resource.data.get('periodKey', '') &&
          request.resource.data.get('policySnapshot', {}) == resource.data.get('policySnapshot', {}) &&
          request.resource.data.get('journalId', '') == resource.data.get('journalId', '');
        // Posting only moves an approved case to posted and stamps the journal.
        allow update: if peopleHrAllowed(companyId, 'people.post_deductions') && resource != null &&
          resource.data.get('status', '') == 'approved' &&
          request.resource.data.get('status', '') == 'posted' &&
          request.resource.data.get('journalId', '') != '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'journalId', 'updatedAt']);
        // Reversal is always attributed and never by the subject.
        allow update: if peopleHrAllowed(companyId, 'people.reverse_deductions') && resource != null &&
          resource.data.get('status', '') == 'posted' &&
          request.resource.data.get('status', '') == 'reversed' &&
          request.resource.data.get('reversedBy', '') == request.auth.uid &&
          caseSubjectUid(resource.data) != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversedBy', 'reversedAt', 'reversalNote', 'updatedAt']);
        allow delete: if false;
      }

      // Attendance: members read the team's sheet (unchanged), a person may
      // open/close ONLY their own sessions, and the punch identity fields are
      // immutable for everyone. Corrections (lateness, status, notes, the
      // schedule snapshot, the audit trail) require people.correct_attendance
      // and are appended — never overwritten.
      match /attendance/{attendanceId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId) && (
          peopleHrAllowed(companyId, 'people.correct_attendance')
          || isOwnAttendanceCreate(request.resource.data)
        );
        allow update: if belongsToCompany(companyId) && resource != null && (
          // identity is immutable for every writer
          request.resource.data.get('employeeId', '') == resource.data.get('employeeId', '')
          && request.resource.data.get('date', '') == resource.data.get('date', '')
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        ) && (
          peopleHrAllowed(companyId, 'people.correct_attendance')
          // self close-out: only checkout/time/geo/report fields
          || (
            isMyAttendance(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'checkOut', 'totalHours', 'updatedAt',
              'checkOutLat', 'checkOutLng', 'checkOutLocationId', 'checkOutLocationName', 'checkOutDistanceMeters',
              'location', 'notes', 'hasDailyReport', 'dailyReportId', 'skippedReport'
            ])
          )
        );
        allow delete: if false;
      }

      // Settings stay member-writable EXCEPT the legacy attendance cutoff
      // policy and financial fiscal closing, which are strictly guarded.
      match /settings/{settingId} {
        allow read: if belongsToCompany(companyId);
        // First REM code allocation creates the counter doc — no prior value to
        // rewind, so a plain member gate is enough (attendance still needs the
        // schedule-management capability; fiscal_closing requires company admin).
        allow create: if belongsToCompany(companyId) && (
          (settingId != 'attendance' && settingId != 'fiscal_closing')
          || (settingId == 'attendance' && peopleHrAllowed(companyId, 'people.manage_schedules'))
          || (settingId == 'fiscal_closing' && isCompanyAdmin(companyId))
        );
        // settings/real_estate additionally guards its sequence counters against
        // rewinds; every other setting keeps the original member-writable contract
        // (attendance excepted, behind the schedule-management capability; fiscal_closing behind admin).
        allow update: if belongsToCompany(companyId) && resource != null && (
          (settingId == 'real_estate' && remSequenceNotRewound())
          || (settingId == 'attendance' && peopleHrAllowed(companyId, 'people.manage_schedules'))
          || (settingId == 'fiscal_closing' && isCompanyAdmin(companyId))
          || (settingId != 'attendance' && settingId != 'real_estate' && settingId != 'fiscal_closing')
        );
        allow delete: if isCompanyAdmin(companyId);
      }

      // Custom Business Modules Engine — module DEFINITIONS. Every tenant
      // member reads them (the workspace must render active modules), but only
      // an administrator holding the configuration capability may create or
      // edit them, and they are never hard-deleted (archival is the safe
      // off-switch, mirroring the service's lifecycle transitions).
      match /module_definitions/{key} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId) && (
          isCompanyAdmin(companyId)
          || 'custom_modules.manage_config' in customPermissions()
        );
        allow delete: if false;
      }

      match /{collection}/{docId} {
        allow read, create, update: if belongsToCompany(companyId)
          && collection != 'daily_reports'
          && collection != 'conversations'
          && collection != 'journals'
          && collection != 'payments'
          && collection != 'vouchers'
          && collection != 'payroll_payments'
          && collection != 'bills'
          && collection != 'rem_leases'
          && collection != 'rem_rent_installments'
          && collection != 'rem_rent_payments'
          && collection != 'rem_security_deposits'
          && collection != 'rem_property_expenses'
          && collection != 'attendance'
          && collection != 'settings'
          && collection != 'module_definitions'
          && collection != 'hr_schedule_templates'
          && collection != 'hr_schedule_assignments'
          && collection != 'hr_lateness_policies'
          && collection != 'hr_deduction_cases'
          && collection != 'audit_logs'
          && collection != 'employees'
          && collection != 'invoices'
          && isKnownGenericCollection(collection)
          && (!isDomainCollection(collection) || domainAccessAllowed(companyId, collection));

        // Generic collection deletion: strictly restricted to Company Admins and Platform Admins.
        // Prevents unauthorized deletion of any tenant records by regular employees.
        allow delete: if belongsToCompany(companyId)
          && collection != 'daily_reports'
          && collection != 'conversations'
          && collection != 'journals'
          && collection != 'payments'
          && collection != 'vouchers'
          && collection != 'payroll_payments'
          && collection != 'bills'
          && collection != 'rem_leases'
          && collection != 'rem_rent_installments'
          && collection != 'rem_rent_payments'
          && collection != 'rem_security_deposits'
          && collection != 'rem_property_expenses'
          && collection != 'attendance'
          && collection != 'settings'
          && collection != 'module_definitions'
          && collection != 'hr_schedule_templates'
          && collection != 'hr_schedule_assignments'
          && collection != 'hr_lateness_policies'
          && collection != 'hr_deduction_cases'
          && collection != 'audit_logs'
          && collection != 'employees'
          && collection != 'invoices'
          && isKnownGenericCollection(collection)
          && (!isDomainCollection(collection) || domainAccessAllowed(companyId, collection))
          && (isCompanyAdmin(companyId) || isPlatformAdmin());

        // Nested data such as tasks/{id}/comments
        match /{nested=**} {
          allow read, create, update: if belongsToCompany(companyId)
            && collection != 'daily_reports'
            && collection != 'conversations'
            && collection != 'journals'
            && collection != 'payments'
            && collection != 'vouchers'
            && collection != 'payroll_payments'
            && collection != 'bills'
            && collection != 'rem_leases'
            && collection != 'rem_rent_installments'
            && collection != 'rem_rent_payments'
            && collection != 'rem_security_deposits'
            && collection != 'rem_property_expenses'
            && collection != 'attendance'
            && collection != 'settings'
            && collection != 'module_definitions'
            && collection != 'hr_schedule_templates'
            && collection != 'hr_schedule_assignments'
            && collection != 'hr_lateness_policies'
            && collection != 'hr_deduction_cases'
            && collection != 'audit_logs'
            && collection != 'employees'
            && collection != 'invoices'
            && isKnownGenericCollection(collection)
            && (!isDomainCollection(collection) || domainAccessAllowed(companyId, collection));

          allow delete: if belongsToCompany(companyId)
            && collection != 'daily_reports'
            && collection != 'conversations'
            && collection != 'journals'
            && collection != 'payments'
            && collection != 'vouchers'
            && collection != 'payroll_payments'
            && collection != 'bills'
            && collection != 'rem_leases'
            && collection != 'rem_rent_installments'
            && collection != 'rem_rent_payments'
            && collection != 'rem_security_deposits'
            && collection != 'rem_property_expenses'
            && collection != 'attendance'
            && collection != 'settings'
            && collection != 'module_definitions'
            && collection != 'hr_schedule_templates'
            && collection != 'hr_schedule_assignments'
            && collection != 'hr_lateness_policies'
            && collection != 'hr_deduction_cases'
            && collection != 'audit_logs'
            && collection != 'employees'
            && collection != 'invoices'
            && isKnownGenericCollection(collection)
            && (!isDomainCollection(collection) || domainAccessAllowed(companyId, collection))
            && (isCompanyAdmin(companyId) || isPlatformAdmin());
        }
      }
    }
  }
}
