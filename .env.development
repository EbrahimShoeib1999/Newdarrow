# ---------------------------------------------------------------------------
# Development-mode Firebase environment (Vite mode = "development").
#
# WHY THIS FILE EXISTS
# The generic `.env` / `.env.local` files carry the PRODUCTION Firebase
# configuration (project "d-arrow-buisiness"). Because `.env` / `.env.local`
# are loaded in EVERY mode, a plain `npm run dev` was silently talking to the
# production project - the browser console printed
#   "[Firebase] Connected to Production Project: d-arrow-buisiness"
# and every local read/write hit production data and production rules.
#
# Vite env precedence (Vite >=5, verified in node_modules/vite loadEnv):
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local  <  process.env
# This file is `.env.[mode]`, so it applies to `npm run dev` ONLY.
# `npm run build` / `npm run preview` run in "production" mode and therefore
# keep reading `.env` / `.env.local` -> PRODUCTION Firebase, unchanged.
#
# Nothing here is a secret and nothing here is deployed.
#
# To deliberately develop against production again (e.g. a migration stage),
# set VITE_USE_FIREBASE_EMULATORS=false in this file - production credentials
# are never removed from `.env`.
# ---------------------------------------------------------------------------

# Route the local app at the Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Clearly-local project identity (the emulator accepts any project id).
VITE_FIREBASE_PROJECT_ID=d-arrow-local
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_STORAGE_BUCKET=d-arrow-local.appspot.com
