rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToCompany(companyId) {
      return signedIn() && hasUserDoc() && userDoc().companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return belongsToCompany(companyId)
        && userDoc().role in ['super_admin', 'admin'];
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /companies/{companyId} {
      allow read, write: if belongsToCompany(companyId);

      match /employees/{employeeId} {
        allow read, write: if belongsToCompany(companyId);
      }
      match /attendance/{attendanceId} {
        allow read, write: if belongsToCompany(companyId);
      }
      match /settings/{settingId} {
        allow read, write: if belongsToCompany(companyId);
      }

      // V4 probe: `in`-guarded key membership instead of .get(key, default).
      // Hypothesis from v2/v3: the emulator ERRORS on .get(key, default) when
      // the key is absent on a REAL doc, but `key in map` is safe.
      match /conversations/{conversationId} {
        allow read: if belongsToCompany(companyId) && (
          ('type' in resource.data && resource.data.type == 'public')
          || ('type' in resource.data && resource.data.type == 'channel' && (!('visibility' in resource.data) || resource.data.visibility == 'public'))
          || ('memberIds' in resource.data && resource.data.memberIds is list && request.auth.uid in resource.data.memberIds)
          || isCompanyAdmin(companyId)
        );
        allow create: if belongsToCompany(companyId);
      }
    }
  }
}
