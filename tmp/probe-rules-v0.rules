rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToCompany(companyId) {
      return signedIn() && hasUserDoc() && userDoc().companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return belongsToCompany(companyId)
        && userDoc().role in ['super_admin', 'admin'];
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /companies/{companyId} {
      allow read, write: if belongsToCompany(companyId);

      match /conversations/{conversationId} {
        allow read: if belongsToCompany(companyId);
      }
    }
  }
}
