{
  "testEnvironment": "node",
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testMatch": ["**/*.e2e-spec.ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|@prisma|bcryptjs|uuid|supertest|class-validator|class-transformer|reflect-metadata))"
  ],
  "moduleFileExtensions": ["ts", "js", "json"],
  "clearMocks": true,
  "testTimeout": 60000
}
