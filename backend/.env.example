# D-Arrow backend — local development environment template.
# Copy this file to backend/.env (gitignored) and adjust values.
# Real environment variables always win over this file. Never commit real secrets.

# development | test | production (validated at boot; unknown values fail fast)
NODE_ENV=development

# HTTP port the API listens on (default 3001)
PORT=3001

# PostgreSQL — the owner's local PostgreSQL 18 service (see "Local database" in README):
#   host localhost, port 5432; dedicated non-superuser role `darrow`;
#   databases darrow_dev (app + migrations) and darrow_test (test harness).
#   This server also hosts unrelated databases (e.g. dearrow) — never point D-Arrow at them.
# DATABASE_URL=postgresql://darrow:CHANGE_ME@localhost:5432/darrow_dev
# DATABASE_TEST_URL=postgresql://darrow:CHANGE_ME@localhost:5432/darrow_test
